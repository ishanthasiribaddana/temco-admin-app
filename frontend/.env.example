# =============================================================================
# TEMCO Admin Portal - Environment Variables
# =============================================================================
# Copy this file to .env and update values as needed.
# These are only used when NOT relying on Vite proxy (e.g., Docker builds).
# For local dev with `npm run dev`, the Vite proxy handles API routing.
# =============================================================================

# Backend API URL (temco-loan-system on WildFly)
VITE_API_URL=http://localhost:8080/temco-loan-system/api/v1/customer
