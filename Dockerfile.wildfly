# =============================================================================
# WildFly 27.0.1 with Java 17 for TEMCO AdminApp
# =============================================================================
# Admin portal backend — JAX-RS API server.
# Port: 8088 (mapped from container 8080)
# Context: /temco-bank
# =============================================================================
FROM quay.io/wildfly/wildfly:27.0.1.Final-jdk17

# Environment variables (overridden by docker-compose)
ENV DB_HOST=mariadb \
    DB_PORT=3306 \
    DB_NAME=temco_system \
    DB_USER=root \
    DB_PASSWORD=6qZB6d@pIvj

# Install MySQL/MariaDB JDBC driver as a WildFly module
USER root
RUN mkdir -p /opt/jboss/wildfly/modules/system/layers/base/com/mysql/main
COPY --chown=jboss:jboss mysql-connector-java-8.1.0.jar /opt/jboss/wildfly/modules/system/layers/base/com/mysql/main/
COPY --chown=jboss:jboss wildfly-module/module.xml /opt/jboss/wildfly/modules/system/layers/base/com/mysql/main/module.xml
USER jboss

# Add management user
RUN /opt/jboss/wildfly/bin/add-user.sh admin admin123 --silent

# Configure JDBC driver and datasource using CLI
RUN /opt/jboss/wildfly/bin/jboss-cli.sh --commands="embed-server, \
/subsystem=datasources/jdbc-driver=mariadb:add(driver-name=mariadb,driver-module-name=com.mysql,driver-class-name=com.mysql.cj.jdbc.Driver), \
stop-embedded-server"

RUN /opt/jboss/wildfly/bin/jboss-cli.sh --commands="embed-server, \
/subsystem=datasources/data-source=TemcoDB:add(jndi-name=java:jboss/datasources/TemcoDB,driver-name=mariadb,connection-url=\"jdbc:mysql://${env.DB_HOST}:${env.DB_PORT}/${env.DB_NAME}?useSSL=false&allowPublicKeyRetrieval=true\",user-name=${env.DB_USER},password=${env.DB_PASSWORD},min-pool-size=5,max-pool-size=20), \
stop-embedded-server"

# Expose ports
EXPOSE 8080 9990 8787

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -f http://localhost:8080/temco-bank/api/v1/health || exit 1

# Start WildFly with management and debug
CMD ["/opt/jboss/wildfly/bin/standalone.sh", "-b", "0.0.0.0", "-bmanagement", "0.0.0.0", "--debug"]
