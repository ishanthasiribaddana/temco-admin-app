# =============================================================================
# PRODUCTION ENVIRONMENT
# =============================================================================
# Copy this file to .env.prod on the production server
# Usage: docker-compose -f docker-compose.base.yml -f docker-compose.prod.yml --env-file .env.prod up -d

# Database (Host MariaDB)
DB_PASSWORD=<production-db-password>

# WildFly Admin
WILDFLY_USER=admin
WILDFLY_PASSWORD=<secure-password>

# Frontend
VITE_USE_MOCK_AUTH=false
